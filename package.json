{
  "name": "site",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "author": {
    "name": "Lazy-And-Focused",
    "url": "https://laf-team.ru",
    "email": "love.laf.command@gmail.com"
  },
  "license": "MIT",
  "keywords": [],
  "main": "index.js",
  "workspaces": [
    "apps/**",
    "packages/**"
  ],
  "scripts": {
    "lint": "eslint ./ --stats",
    "lint:fix": "eslint --fix",
    "prettier": "prettier . -c -w",
    "fockbuilder": "fockbuilder --start",
    "build:all": "pnpm --filter {./**} build",
    "build:apps": "pnpm --filter ./apps/** build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:packages": "pnpm --filter ./packages/** build",
    "start:backend": "pnpm --filter backend start",
    "start:frontend": "pnpm --filter frontend start",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "fock-builder": "2.0.0-beta.1h",
    "globals": "^15.15.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript-eslint": "^8.44.1"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.7.0"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp"
    ],
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "esbuild",
      "node"
    ]
  }
}
